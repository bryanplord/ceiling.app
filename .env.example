# intervals.icu → Settings → Developer Settings. Never commit the real value.
INTERVALS_API_KEY=
# 0 means "the owner of the API key"
INTERVALS_ATHLETE_ID=0

# Where the SQLite database and Garmin tokens live (outside git)
RX_DATA_DIR=./data

# Your local time zone: decides what "today" and "tonight" mean
RX_TZ=America/Los_Angeles

# Sign-in (magic link). For local development you can skip all of this with RX_OPEN=1
RX_OPEN=1
RX_ALLOWED_EMAILS=
RX_SECRET=
RX_BASE_URL=http://127.0.0.1:8000
# Leave empty locally: the sign-in link is printed in the terminal instead of emailed
RESEND_API_KEY=
RX_FROM_EMAIL=Ceiling <signin@ceiling.app>
